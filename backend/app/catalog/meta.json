  "avery-zweckform-l4731rev": {
    "revision": 1,
    "verified_on": "2026-11-15",
    "evidence": "Verified on real sheets 2026-11-15: HP Color LaserJet, tray 1, check print with correction. The earlier geometry (top margin 13.5 mm, rows 10.0 mm) put every row line 0.7–1.3 mm low; corrected to top 12.54 mm and 9.98 mm rows. Vendor page not reachable; values agree between two third-party sources for this size (Labelplanet LP189/25, MR-Label MR111, listed there as the L4731 size; second source: http://mr-label.com/articles/3884). Corner radius 1.47 mm from MR-Label MR111, rounded to 1.5.",
    "baseline_fields_hash": "976a304d44b258be0051e0434689b2bcc379f0c948c1d080506c402beee73f1c"
