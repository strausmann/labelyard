#
# systemd unit of the USB network bridge (examples/usb-bridge/ptouch_bridge.py).
# Install: /usr/local/bin/ptouch-bridge (the script) and /etc/systemd/system/ptouch-bridge.service,
# then: sudo systemctl daemon-reload && sudo systemctl enable --now ptouch-bridge

[Unit]
Description=USB network bridge for a Brother P-touch (TCP 9100 + SNMP) for Labelyard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 -u /usr/local/bin/ptouch-bridge
Environment=PTB_DEVICE=/dev/usb/lp0
Environment=PTB_NET_IF=wlan0
Environment=PTB_COMMUNITY=public
Environment=PTB_LABEL_COUNTER=auto
Restart=always
RestartSec=2

# No root: the printer device belongs to the group lp, and port 161 needs one capability.
DynamicUser=yes
SupplementaryGroups=lp
StateDirectory=ptouch-bridge
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
